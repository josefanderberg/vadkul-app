{
  "expo": {
    "name": "VADKUL",
    "slug": "vadkul-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vadkulapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "se.vadkul.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VADKUL använder din plats för att visa event nära dig och välja rätt län för eventflödet.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:vadkul.se",
        "applinks:vadkul.se"
      ],
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "se.vadkul.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#006aa7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vadkul.se",
              "pathPrefix": "/e/"
            },
            {
              "scheme": "https",
              "host": "vadkul.se",
              "pathPrefix": "/evenemang/"
            },
            {
              "scheme": "https",
              "host": "vadkul.se",
              "pathPrefix": "/arrangor/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006aa7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "VADKUL använder dina bilder när du lägger till en omslagsbild på ett event du skapar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f01f79f6-725b-4b7b-a20e-7f577db7d8d2"
      }
    },
    "owner": "josefanderberg",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f01f79f6-725b-4b7b-a20e-7f577db7d8d2"
    }
  }
}
